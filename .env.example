# Скопируйте в .env и измените под своё окружение.
# Значения ниже — безопасные настройки по умолчанию.

# --- Ollama / LLM ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT=300
LLM_NUM_CTX=16384

# --- Оценка ---
DEFAULT_MAX_SCORE=100
GRADE_MAX_RETRIES=2

# --- Лимиты загрузки и контекста ---
MAX_FILES=100
MAX_FILE_BYTES=524288
MAX_TOTAL_BYTES=8388608
MAX_ARCHIVE_ENTRIES=1000
MAX_CONTEXT_CHARS=60000
MAX_CHUNK_CHARS=15000
MAX_ANALYSIS_CHARS=12000

# --- Песочница ---
SANDBOX_ENABLED=true
SANDBOX_BACKEND=docker
# Локальный запуск не изолирован. Включайте только на доверенной машине.
SANDBOX_ALLOW_LOCAL=false
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TIMEOUT_SEC=15
SANDBOX_MEMORY_MB=256
SANDBOX_OUTPUT_LIMIT_BYTES=65536
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=128
SANDBOX_TMPFS_MB=16
SANDBOX_USER=65534:65534

# --- HTTP API ---
API_HOST=127.0.0.1
API_PORT=8000
# Пустое значение отключает проверку ключа. Для сетевого доступа задайте ключ.
API_KEY=
# 0 отключает ограничение частоты запросов.
RATE_LIMIT_PER_MINUTE=0
